  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "playwright": "1.61.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
