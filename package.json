{
  "name": "ui-ux-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "run": "tsx src/cli.ts",
    "schema": "tsx src/schema.ts",
