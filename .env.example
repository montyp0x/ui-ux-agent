# Copy to .env (gitignored) and fill in. Shell variables override this file.
# Loaded automatically from the working directory, or pass --env-file PATH.

# Planner: any OpenAI-compatible Chat Completions endpoint with image input
# and json_schema structured output. Defaults to OpenRouter.
PLANNER_API_URL=https://openrouter.ai/api/v1/chat/completions
PLANNER_API_KEY=
PLANNER_MODEL=openai/gpt-6-astra
# Optional JSON object of extra request headers, for gateways that need them.
# PLANNER_API_HEADERS='{"X-Example-Header":"value"}'

# Selector: TypeSafe Jev by default.
JEV_API_KEY=
# SELECTOR_API_URL=https://api.typesafe.ai/v1/systemone
# SELECTOR_MODEL=jev-latest

# Client-side rate limits per endpoint (optional). A 429 or 503 is always
# retried after Retry-After (or a backoff) within the step's time budget, and
# halves that endpoint's rate until calls succeed again; these set the caps.
# PLANNER_MAX_RPM=60
# PLANNER_MAX_CONCURRENCY=2
# SELECTOR_MAX_RPM=300
# SELECTOR_MAX_CONCURRENCY=4
